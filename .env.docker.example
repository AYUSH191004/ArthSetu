# Copy to .env (repo root) before `docker compose up` for a real deployment.
# Left unset, docker-compose.yml falls back to insecure defaults suitable
# only for a local trial run — see docker-compose.yml.

# APP_ENV=production makes the backend refuse to start unless SECRET_KEY and
# BOOTSTRAP_ADMIN_PASSWORD below are also overridden (backend/app/core/config.py).
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_USER=arthsetu
POSTGRES_PASSWORD=
POSTGRES_DB=arthsetu

# Browser origins allowed to call the API (comma-separated). Set this to
# your real frontend origin(s) in production.
CORS_ORIGINS=http://localhost:8080

# uvicorn worker processes in the backend container.
WEB_CONCURRENCY=2
